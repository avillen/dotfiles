# Valores propios de cada maquina/organizacion. Copia este fichero a
# ~/.config/dotfiles/local.env y rellenalo; ese destino esta FUERA del repo a
# proposito, para que no se pueda commitear por accidente (dotfiles es publico).
#
#   cp worktrunk/local.env.example ~/.config/dotfiles/local.env
#
# Todo es opcional: sin el fichero, los scripts siguen funcionando con el
# comportamiento generico que se describe en cada variable.

# Prefijo y sufijo que se recortan del basename del repo para construir el
# nombre del proyecto de compose. Con los dos vacios se usa el basename entero,
# que tambien vale: los caracteres no admitidos se sustituyen igualmente.
#   WT_REPO_PREFIX="acme."   ->  acme.foo.api + rama x  ->  foo-api-x
WT_REPO_PREFIX=""
WT_REPO_SUFFIX=""

# Nombre del proyecto de compose que el Makefile del repo fija con '-p'. Es el
# entorno COMPARTIDO del checkout principal, el que hay que evitar desde un
# worktree. Se usa para dos cosas:
#   - fallback de `lmwhere` cuando no estas en un worktree enlazado
#   - reglas deny que impiden al agente entrar en ese entorno desde un worktree
# Sin definir, `lmwhere` pide el nombre y no se escribe ninguna regla deny.
WT_SHARED_PROJECT=""

# Fichero de aliases del trabajo, si lo hay. Se sourcea desde .zshrc.
WORK_ALIASES=""
