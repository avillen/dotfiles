#!/bin/sh
# hd — flujo de trabajo de worktrees sobre herdr + worktrunk.
#
#   hd add <rama>    crea el worktree (disparando los hooks de worktrunk, que
#                    montan su entorno Docker) y rehace la TAB ACTUAL con el
#                    layout: claude arriba y una terminal abajo, en el worktree.
#                    Los paneles que hubiera en la tab se cierran.
#   hd remove        borra el worktree en el que estas: baja su entorno Docker
#                    (hook pre-remove) y cierra las tabs que vivian dentro
#   hd remove <rama> lo mismo, para una rama concreta
#   hd <cualquier>   se lo pasa tal cual a herdr
#
# herdr no tiene layouts declarativos: el layout se construye a mano en la
# funcion layout() de aqui abajo, via la API de sockets. Se toca ahi.
set -eu

die() { echo "hd: $*" >&2; exit 1; }

# Extrae una ruta de claves del JSON que devuelven los comandos de herdr.
get() { python3 -c 'import json,sys; print(json.load(sys.stdin)'"$1"')'; }

# Los pane_id de una tab.
panes_in_tab() {
  herdr pane list --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null | python3 -c 'import json,sys
tab = sys.argv[1]
for p in json.load(sys.stdin)["result"]["panes"]:
    if p.get("tab_id") == tab:
        print(p["pane_id"])' "$1"
}

# Layout en la tab ACTUAL: claude arriba y una terminal abajo.
#
#   +----------------------+
#   |                      |
#   |        claude        |   75%
#   |                      |
#   +----------------------+
#   |         zsh          |   25%
#   +----------------------+
#
# No se puede cambiar el cwd de un panel que ya existe, asi que los dos paneles
# se crean nuevos con el cwd del worktree y los viejos de la tab se cierran
# despues. El propio panel desde el que se lanza hd tambien se cierra, y va el
# ultimo: al cerrarlo muere este script.
#
# Sin panel fijo de nvim: lo cubre el sidebar de herdr-nvim (prefix+e).
layout() {
  cwd=$1; name=$2

  # La lista de paneles viejos se toma ANTES de crear los nuevos, para no
  # tener que distinguirlos despues.
  olds=$(panes_in_tab "$HERDR_TAB_ID")

  # --focus en el de claude para que el foco ya este ahi cuando cerremos los
  # viejos; si no, al cerrar el panel actual el foco acabaria en cualquier sitio.
  agent_pane=$(herdr pane split "$HERDR_PANE_ID" --direction down \
                 --cwd "$cwd" --focus | get '["result"]["pane"]["pane_id"]')

  # --ratio es la fraccion que se queda el panel que PARTES, no el nuevo.
  # herdr no lo documenta; comprobado a mano.
  herdr pane split "$agent_pane" --direction down --ratio 0.75 \
    --cwd "$cwd" --no-focus > /dev/null

  start_agent "$agent_pane" "$name"

  # Los viejos, el propio al final.
  for old in $olds; do
    [ "$old" = "$HERDR_PANE_ID" ] && continue
    herdr pane close "$old" > /dev/null 2>&1 || true
  done
}

# Arranca claude esperando a que el shell del panel llegue a su prompt.
#
# `agent start` exige el panel EN su prompt y por dentro solo reintenta unos
# 110 ms diez veces (~1 s) antes de rendirse con `agent_pane_busy`. Un segundo
# no basta: el .zshrc carga oh-my-zsh, asdf, gcloud y un `brew --prefix nvm`
# que es un subproceso, y encima el hook post-start de worktrunk esta
# levantando el entorno Docker en paralelo. Asi que reintentamos aqui.
#
# Los nombres de agente deben casar [a-z][a-z0-9_-]{0,31} y ser unicos.
start_agent() {
  pane=$1; name=$2; waited=0
  while :; do
    # Se captura solo stderr: ahi es donde herdr deja el JSON del error.
    if err=$(herdr agent start "$name" --kind claude --pane "$pane" 2>&1 > /dev/null); then
      return 0
    fi
    case "$err" in
      *agent_pane_busy*)
        [ "$waited" -ge 45 ] && break
        [ "$waited" -eq 0 ] && echo "hd: esperando a que arranque el shell del panel..."
        sleep 1
        waited=$((waited + 1))
        ;;
      # Cualquier otro error no se arregla esperando.
      *) break ;;
    esac
  done
  echo "hd: claude no arranco en $pane tras ${waited}s: $err" >&2
  echo "hd: arrancalo a mano con 'claude' en ese panel" >&2
}

# Ruta del worktree de una rama. El schema del JSON va fijado a proposito:
# worktrunk avisa de que una version futura cambia el default, y eso romperia
# este parseo en silencio.
worktree_path() {
  wt list --format=json --config-set list.json-schema=1 2>/dev/null \
    | python3 -c 'import json,sys
branch = sys.argv[1]
for w in json.load(sys.stdin):
    if w.get("branch") == branch:
        print(w["path"]); break' "$1"
}

add() {
  branch=${1:-} ; [ -n "$branch" ] || die "uso: hd add <rama>"

  [ "${HERDR_ENV:-}" = 1 ] || die "esto solo funciona dentro de un panel de herdr"
  [ -n "${HERDR_WORKSPACE_ID:-}" ] || die "no encuentro el space actual"
  [ -n "${HERDR_TAB_ID:-}" ] || die "no encuentro la tab actual"
  [ -n "${HERDR_PANE_ID:-}" ] || die "no encuentro el panel actual"
  git rev-parse --is-inside-work-tree > /dev/null 2>&1 || die "no estas en un repo git"

  # --no-cd porque la navegacion la hace herdr, no la shell. Los hooks (o sea,
  # el arranque del entorno Docker) corren igual.
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    wt switch "$branch" --no-cd
  else
    wt switch --create "$branch" --no-cd
  fi

  path=$(worktree_path "$branch")
  [ -n "$path" ] || die "no encuentro el worktree de '$branch'"

  # La tab pasa a llamarse como la rama. Antes lo hacia el --label de
  # `tab create`, que ya no se usa: se reutiliza la tab actual.
  herdr tab rename "$HERDR_TAB_ID" "$branch" > /dev/null 2>&1 || true

  name=$(printf '%s' "$branch" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_-' '-' | cut -c1-32)

  # Se imprime antes del layout: el panel donde se ve esto se cierra al final.
  echo "hd: '$branch' listo en $path"
  layout "$path" "$name"

  # El panel desde el que lanzaste hd, el ultimo. Aqui muere el script.
  herdr pane close "$HERDR_PANE_ID" > /dev/null 2>&1 || true
}

# Devuelve los tab_id cuyos paneles viven dentro de la ruta dada. Se localiza
# por cwd y no por nombre de tab: el nombre lo puede haber cambiado el usuario.
tabs_under() {
  herdr pane list 2>/dev/null | python3 -c 'import json,sys,os
root = os.path.realpath(sys.argv[1])
tabs = []
for p in json.load(sys.stdin)["result"]["panes"]:
    cwd = p.get("cwd") or ""
    try:
        cwd = os.path.realpath(cwd)
    except OSError:
        continue
    if cwd == root or cwd.startswith(root + os.sep):
        if p["tab_id"] not in tabs:
            tabs.append(p["tab_id"])
print("\n".join(tabs))' "$1"
}

remove() {
  branch=${1:-}
  git rev-parse --is-inside-work-tree > /dev/null 2>&1 || die "no estas en un repo git"

  main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  top=$(git rev-parse --show-toplevel)

  # Sin argumento: el worktree en el que estas, que es el caso normal (acabas
  # el trabajo y lo tiras desde dentro).
  if [ -z "$branch" ]; then
    [ "$top" != "$main" ] || die "estas en el checkout principal: di que rama borrar"
    branch=$(git rev-parse --abbrev-ref HEAD)
    [ "$branch" != "HEAD" ] || die "worktree en HEAD suelto: di que rama borrar"
  fi

  path=$(worktree_path "$branch")
  [ -n "$path" ] || die "no encuentro el worktree de '$branch'"
  [ "$path" != "$main" ] || die "no voy a borrar el checkout principal"

  # Se anotan ANTES del borrado: despues el cwd de los paneles ya no existe y
  # no habria forma de relacionarlos con el worktree.
  tabs=$(tabs_under "$path")

  # Nos salimos del worktree antes de tirarlo, para no ejecutar wt desde un
  # directorio que esta a punto de desaparecer.
  cd "$main" || die "no puedo entrar en $main"

  # Sin --yes a proposito: borra rama y worktree, que lo confirme el usuario.
  # Aqui es donde worktrunk lanza el hook pre-remove (el teardown de Docker),
  # con el checkout todavia en su sitio.
  wt remove "$branch" || die "worktrunk no ha borrado '$branch'; no toco las tabs"

  # La tab propia se cierra la ultima: al cerrarla muere este script.
  self=${HERDR_TAB_ID:-}
  mine=no
  for t in $tabs; do
    if [ "$t" = "$self" ]; then
      mine=si
      continue
    fi
    herdr tab close "$t" > /dev/null 2>&1 && echo "hd: cerrada tab $t"
  done

  echo "hd: '$branch' eliminado"
  if [ "$mine" = si ]; then
    herdr tab close "$self" > /dev/null 2>&1 || true
  fi
}

case "${1:-}" in
  add) shift; add "$@" ;;
  remove|rm) shift; remove "$@" ;;
  "")  exec herdr ;;
  *)   exec herdr "$@" ;;
esac
